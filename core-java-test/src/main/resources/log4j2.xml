<?xml version="1.0" encoding="UTF-8"?>
<!--
  core-java-test — sync logging configuration (default).
  Appenders:
    Console      → human-readable PatternLayout  (local dev)
    JsonConsole  → JsonTemplateLayout + Docker containerId  (Docker/K8s/ELK)
    RollingFile  → rolling text log file
    JsonRolling  → rolling JSON log file (for Fluentd/Logstash sidecar)
-->
<Configuration status="INFO" name="CoreJavaTest">

    <Properties>
        <Property name="LOG_DIR">logs</Property>
        <Property name="PATTERN">
            %d{HH:mm:ss.SSS} [%-20t] %-5level %-35logger{1.} [%X{traceId:-}|%X{userId:-}] - %msg%n
        </Property>
    </Properties>

    <Appenders>

        <!-- 1. Console — plain text, for local development -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATTERN}"/>
        </Console>

        <!-- 2. JSON Console — for Docker/K8s stdout capture -->
        <Console name="JsonConsole" target="SYSTEM_OUT">
            <JsonTemplateLayout>
                <!-- Docker containerId lookup; falls back to 'unknown' outside Docker -->
                <EventTemplateAdditionalField key="containerId" value="${docker:containerId:-unknown}"/>
                <EventTemplateAdditionalField key="app"         value="core-java-test"/>
            </JsonTemplateLayout>
        </Console>

        <!-- 3. Rolling File — plain text, per-MINUTE + 1KB size rollover to force compression in testing -->
        <RollingFile name="RollingFile"
                     fileName="${LOG_DIR}/app.log"
                     filePattern="${LOG_DIR}/app-%d{yyyy-MM-dd-HH-mm}-%i.log.gz">
            <PatternLayout pattern="${PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="1KB"/>
            </Policies>
            <DefaultRolloverStrategy max="20" maxCompressionDelaySeconds="3"/>
        </RollingFile>

        <!-- 4. Rolling File — JSON, per-MINUTE + 1KB size rollover to force compression in testing -->
        <RollingFile name="JsonRollingFile"
                     fileName="${LOG_DIR}/app-json.log"
                     filePattern="${LOG_DIR}/app-json-%d{yyyy-MM-dd-HH-mm}-%i.log.gz">
            <JsonTemplateLayout>
                <EventTemplateAdditionalField key="containerId" value="${docker:containerId:-unknown}"/>
                <EventTemplateAdditionalField key="app"         value="core-java-test"/>
            </JsonTemplateLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="1KB"/>
            </Policies>
            <DefaultRolloverStrategy max="20" maxCompressionDelaySeconds="3"/>
        </RollingFile>

        <!-- 5. Rolling File — DST bug reproduction: CronTriggeringPolicy, daily rollover, no hour in pattern -->
        <RollingFile name="CronDailyFile"
                     fileName="${LOG_DIR}/cron-daily.log"
                     filePattern="${LOG_DIR}/cron-daily-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${PATTERN}"/>
            <Policies>
                <CronTriggeringPolicy schedule="0 0 0 ? * * *"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>

    </Appenders>

    <Loggers>
        <!-- App packages: TRACE to capture all test scenarios -->
        <Logger name="com.playground" level="trace" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="JsonConsole"/>
            <AppenderRef ref="RollingFile"/>
            <AppenderRef ref="JsonRollingFile"/>
            <AppenderRef ref="CronDailyFile"/>
        </Logger>

        <!-- Root: INFO for any third-party logs -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="JsonConsole"/>
        </Root>
    </Loggers>

</Configuration>

