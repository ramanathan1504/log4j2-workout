{
  "configuration": {
    "status": "WARN",
    "name": "arbiters",

    "properties": {
      "property": [
        { "name": "dir", "value": "${sys:bench.log.dir:-logs}/arbiters" },
        { "name": "pattern", "value": "%d{HH:mm:ss.SSS} %-5level %logger{1.} - %msg%n" }
      ]
    },

    "appenders": {
      "Console": {
        "name": "Console",
        "target": "SYSTEM_OUT",
        "PatternLayout": { "pattern": "[always] ${pattern}" }
      },

      "SystemPropertyArbiter": [
        {
          "propertyName": "env",
          "propertyValue": "prod",
          "File": {
            "name": "ByProperty",
            "fileName": "${dir}/env-prod.log",
            "append": "false",
            "PatternLayout": { "pattern": "[sysprop:prod] ${pattern}" }
          }
        },
        {
          "propertyName": "env",
          "propertyValue": "dev",
          "File": {
            "name": "ByProperty",
            "fileName": "${dir}/env-dev.log",
            "append": "false",
            "PatternLayout": { "pattern": "[sysprop:dev] ${pattern}" }
          }
        }
      ],

      "EnvironmentArbiter": {
        "propertyName": "BENCH_ENV",
        "propertyValue": "prod",
        "File": {
          "name": "ByEnvironment",
          "fileName": "${dir}/bench-env-prod.log",
          "append": "false",
          "PatternLayout": { "pattern": "[env:prod] ${pattern}" }
        }
      },

      "ClassArbiter": [
        {
          "className": "org.apache.logging.log4j.core.layout.JsonLayout",
          "File": {
            "name": "ByClassPresent",
            "fileName": "${dir}/class-present.log",
            "append": "false",
            "PatternLayout": { "pattern": "[class:present] ${pattern}" }
          }
        },
        {
          "className": "com.example.definitely.NotOnTheClasspath",
          "File": {
            "name": "ByClassAbsent",
            "fileName": "${dir}/class-absent.log",
            "append": "false",
            "PatternLayout": { "pattern": "[class:absent] ${pattern}" }
          }
        }
      ],

      "ScriptArbiter": {
        "Script": {
          "name": "IsWeekday",
          "language": "groovy",
          "scriptText": "result = !(Calendar.instance.get(Calendar.DAY_OF_WEEK) in [Calendar.SATURDAY, Calendar.SUNDAY])"
        },
        "File": {
          "name": "ByScript",
          "fileName": "${dir}/script-weekday.log",
          "append": "false",
          "PatternLayout": { "pattern": "[script:weekday] ${pattern}" }
        }
      },

      "Select": {
        "SystemPropertyArbiter": {
          "propertyName": "env",
          "propertyValue": "prod",
          "File": {
            "name": "Selected",
            "fileName": "${dir}/selected-prod.log",
            "append": "false",
            "PatternLayout": { "pattern": "[select:prod] ${pattern}" }
          }
        },
        "EnvironmentArbiter": {
          "propertyName": "BENCH_ENV",
          "propertyValue": "prod",
          "File": {
            "name": "Selected",
            "fileName": "${dir}/selected-env-prod.log",
            "append": "false",
            "PatternLayout": { "pattern": "[select:env-prod] ${pattern}" }
          }
        },
        "DefaultArbiter": {
          "File": {
            "name": "Selected",
            "fileName": "${dir}/selected-default.log",
            "append": "false",
            "PatternLayout": { "pattern": "[select:default] ${pattern}" }
          }
        }
      }
    },

    "loggers": {
      "logger": [
        { "name": "org.apache.logging.bench", "level": "TRACE" },
        {
          "name": "org.apache.logging.bench.arbiters",
          "level": "TRACE",
          "additivity": "false",
          "AppenderRef": [
            { "ref": "ByClassPresent" },
            { "ref": "ByScript" }
          ]
        }
      ],
      "root": {
        "level": "INFO",
        "AppenderRef": [
          { "ref": "Console" },
          { "ref": "Selected" }
        ]
      }
    }
  }
}
