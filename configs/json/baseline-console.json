{
  "configuration": {
    "status": "WARN",
    "name": "baseline-console",

    "appenders": {
      "Console": {
        "name": "Console",
        "target": "SYSTEM_OUT",
        "PatternLayout": {
          "pattern": "%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n%throwable"
        }
      }
    },

    "loggers": {
      "logger": [
        {
          "name": "org.apache.logging.bench",
          "level": "TRACE"
        }
      ],
      "root": {
        "level": "INFO",
        "AppenderRef": {
          "ref": "Console"
        }
      }
    }
  }
}
