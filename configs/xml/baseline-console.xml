<?xml version="1.0" encoding="UTF-8"?>
<!--
  Baseline. The smallest useful configuration: one Console appender, one pattern.
  Use this as the control when bisecting a behaviour change — if a problem does
  not show up here, the cause is in a layout, appender or filter, not in core.
-->
<Configuration status="WARN" name="baseline-console">

  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n%throwable"/>
    </Console>
  </Appenders>

  <Loggers>
    <Logger name="org.apache.logging.bench" level="TRACE"/>
    <Root level="INFO">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>

</Configuration>
