<?xml version="1.0" encoding="UTF-8"?>
<!--
  Custom levels. Feature matrix §11.

  A custom level is just a name bound to an integer, and the integer is what
  decides everything. The built-in scale, which custom levels slot into:

    OFF     0
    FATAL 100
    ERROR 200
    WARN  300
    INFO  400
    DEBUG 500
    TRACE 600
    ALL   MAX_VALUE

  Lower is more severe. So intLevel="150" sits between FATAL and ERROR, and a
  logger at ERROR will NOT pass it — the number, not the position in this file,
  is what matters, and getting the direction backwards is the usual mistake.

  Two limits worth knowing before designing around these:

    * The level is global to the JVM once created, not scoped to the
      configuration. A reconfiguration cannot change an existing level's
      integer; Level.forName wins the first time and is then permanent.
    * Log4j's own API has no audit()/notice() method. Reaching a custom level
      means logger.log(Level.forName("AUDIT", 150), ...) or a generated custom
      logger wrapper, so a config alone does not make one usable from code.
-->
<Configuration status="WARN" name="custom-levels">

  <Properties>
    <Property name="dir">${sys:bench.log.dir:-logs}/custom-levels</Property>
    <Property name="pattern">%d{HH:mm:ss.SSS} %-8level %logger{1.} - %msg%n</Property>
  </Properties>

  <!-- CustomLevels must come before anything that references the names. The
       parser is order-sensitive here in a way it is not elsewhere: a filter
       naming AUDIT before this block is resolved gets a level of null and is
       dropped with "Unknown level". -->
  <CustomLevels>
    <!-- Between FATAL (100) and ERROR (200): more severe than an error. -->
    <CustomLevel name="AUDIT" intLevel="150"/>
    <!-- Between WARN (300) and INFO (400): the syslog NOTICE idea. -->
    <CustomLevel name="NOTICE" intLevel="350"/>
    <!-- Between DEBUG (500) and TRACE (600). -->
    <CustomLevel name="VERBOSE" intLevel="550"/>
  </CustomLevels>

  <Appenders>
    <!-- %-8level rather than %-5level: "VERBOSE" is seven characters and would
         otherwise push the columns out. A custom level longer than the padding
         is a common reason a log suddenly looks ragged. -->
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="${pattern}"/>
    </Console>

    <!-- Everything at AUDIT or more severe. Because AUDIT is 150, this file
         also catches FATAL (100) — a threshold is "this severe or more", not
         "this level only". -->
    <File name="AuditFile" fileName="${dir}/audit.log" append="false">
      <PatternLayout pattern="${pattern}"/>
      <ThresholdFilter level="AUDIT" onMatch="ACCEPT" onMismatch="DENY"/>
    </File>

    <!-- Exactly AUDIT and nothing else, which is what an audit trail usually
         wants: LevelMatchFilter, not ThresholdFilter. -->
    <File name="AuditOnlyFile" fileName="${dir}/audit-only.log" append="false">
      <PatternLayout pattern="${pattern}"/>
      <LevelMatchFilter level="AUDIT" onMatch="ACCEPT" onMismatch="DENY"/>
    </File>

    <!-- A band spanning custom and built-in levels: NOTICE (350) down to
         VERBOSE (550) inclusive, so it holds NOTICE, INFO, DEBUG and VERBOSE
         but not WARN or TRACE. minLevel is the more severe bound. -->
    <File name="BandFile" fileName="${dir}/notice-to-verbose.log" append="false">
      <PatternLayout pattern="${pattern}"/>
      <LevelRangeFilter minLevel="NOTICE" maxLevel="VERBOSE"
                        onMatch="ACCEPT" onMismatch="DENY"/>
    </File>

    <!-- Custom levels work in a pattern selector too, which is how you give one
         level a different layout — a full stack for AUDIT, one line for the
         rest. -->
    <File name="SelectorFile" fileName="${dir}/by-level.log" append="false">
      <PatternLayout>
        <LevelPatternSelector defaultPattern="${pattern}">
          <PatternMatch key="AUDIT"
                        pattern="%d{ISO8601} AUDIT %logger - %msg %X%n%xEx{5}"/>
          <PatternMatch key="VERBOSE"
                        pattern="%d{HH:mm:ss.SSS} verbose %logger{1.} - %msg%n"/>
        </LevelPatternSelector>
      </PatternLayout>
    </File>
  </Appenders>

  <Loggers>
    <!-- A logger set to a custom level. VERBOSE is 550, so this passes
         everything down to VERBOSE but stops TRACE (600). -->
    <Logger name="org.apache.logging.bench" level="VERBOSE" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="AuditFile"/>
      <AppenderRef ref="AuditOnlyFile"/>
      <AppenderRef ref="BandFile"/>
      <AppenderRef ref="SelectorFile"/>
    </Logger>

    <Root level="INFO">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>

</Configuration>
