<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <RollingFile name="cron" fileName="${sys:logdir}/app.log"
                 filePattern="${sys:logdir}/app.log.%d{yyyy-MM-dd-HH-mm}">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} %m%n"/>
      <CronTriggeringPolicy schedule="0 * * * * ?" evaluateOnStartup="true"/>
    </RollingFile>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="cron"/>
    </Root>
  </Loggers>
</Configuration>
