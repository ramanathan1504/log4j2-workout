<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="KeylessGelf">
  <Appenders>
    <Console name="Out" target="SYSTEM_OUT">
      <GelfLayout host="myhost" compressionType="OFF" includeNullDelimiter="false">
        <KeyValuePair key="good" value="kept"/>
        <KeyValuePair value="orphan"/>
      </GelfLayout>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="info"><AppenderRef ref="Out"/></Root>
  </Loggers>
</Configuration>
