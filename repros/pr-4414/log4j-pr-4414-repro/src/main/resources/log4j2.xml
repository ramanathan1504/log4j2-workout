<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <File name="FILE" fileName="${sys:outdir}/app.log" append="false">
      <PatternLayout pattern="%p %c %m%n"/>
    </File>
    <Rewrite name="REWRITE">
      <AppenderRef ref="FILE"/>
      <LoggerNameLevelRewritePolicy logger="com.foo">
        <KeyValuePair key="INFO" value="WARN"/>
      </LoggerNameLevelRewritePolicy>
    </Rewrite>
  </Appenders>
  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="REWRITE"/>
    </Root>
  </Loggers>
</Configuration>
