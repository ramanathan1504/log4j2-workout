<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <File name="file" fileName="${sys:outdir}/app.log" append="false">
      <PatternLayout pattern="${sys:undefined.tz:-%d{HH:mm:ss$}{GMT+00$}} %m%n"/>
    </File>
  </Appenders>
  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="file"/>
    </Root>
  </Loggers>
</Configuration>
