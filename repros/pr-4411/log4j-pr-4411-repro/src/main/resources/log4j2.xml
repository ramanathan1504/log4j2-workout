<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <NoSql name="mongo">
      <MessageLayout/>
      <MongoDb4 connection="mongodb://127.0.0.1:27017/log4j.${sys:collection}"/>
    </NoSql>
  </Appenders>
  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="mongo"/>
    </Root>
  </Loggers>
</Configuration>
