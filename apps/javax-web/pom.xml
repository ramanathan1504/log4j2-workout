<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.logging.bench</groupId>
    <artifactId>log4j-bench-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>bench-javax-web</artifactId>
  <name>Log4j Bench :: Javax Web</name>
  <description>log4j-web, log4j-appserver and log4j-taglib on embedded Tomcat 9 (javax.servlet)</description>

  <!--
    2.x ONLY, and javax ONLY. Three modules that all depend on the pre-Jakarta
    servlet API, covered together because they cannot coexist with the jakarta
    ones:

      log4j-web        the javax counterpart of log4j-jakarta-web — per-webapp
                       LoggerContext, ${web:} lookup, plus ServletAppender,
                       which has no jakarta equivalent in the bench yet
      log4j-appserver  routes the CONTAINER's own logging into Log4j, by
                       registering a org.apache.juli.logging.Log through
                       META-INF/services
      log4j-taglib     JSP tags, which need a real JSP engine to mean anything

    Tomcat 9, not 10: 10 moved to jakarta.servlet and none of these three would
    load. The version is pinned explicitly because the Spring Boot BOM the
    parent imports manages tomcat-embed-core to the 10.x line, and inheriting
    that would silently produce a webapp none of these modules can serve.
  -->

  <properties>
    <tomcat9.version>9.0.98</tomcat9.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>${log4j.api.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
    </dependency>

    <!-- The three under test -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-appserver</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-taglib</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-layout-template-json</artifactId>
    </dependency>

    <!-- Embedded Tomcat 9. tomcat-embed-jasper brings the JSP engine, without
         which the taglib is only a jar on the classpath. -->
    <dependency>
      <groupId>org.apache.tomcat.embed</groupId>
      <artifactId>tomcat-embed-core</artifactId>
      <version>${tomcat9.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.tomcat.embed</groupId>
      <artifactId>tomcat-embed-jasper</artifactId>
      <version>${tomcat9.version}</version>
    </dependency>
    <!-- Jasper compiles JSPs with Eclipse JDT at runtime; tomcat-embed-jasper
         does not bring it transitively in this packaging. -->
    <dependency>
      <groupId>org.eclipse.jdt</groupId>
      <artifactId>ecj</artifactId>
      <version>3.46.0</version>
    </dependency>

    <!-- Jasper needs the EL implementation even for a page with no EL in it:
         PageInfo touches javax.el.ExpressionFactory while compiling, so the JSP
         fails with NoClassDefFoundError before the taglib is ever reached. -->
    <dependency>
      <groupId>org.apache.tomcat.embed</groupId>
      <artifactId>tomcat-embed-el</artifactId>
      <version>${tomcat9.version}</version>
    </dependency>

    <!-- Tomcat 9 scans webapp classes for javax.annotation annotations during
         context start, and that API left the JDK in Java 11. Without it the
         context fails with ClassNotFoundException: javax.annotation.Resource
         before any servlet loads — nothing to do with Log4j, but it stops the
         webapp dead. -->
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>org.apache.logging.bench.javaxweb.JavaxWebBench</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
