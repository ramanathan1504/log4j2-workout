<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="composite-foo">
  <Properties>
	<Property name="servletContextName">${web:servletContextName}</Property>
  </Properties>
  <Appenders>
	<Console name="CompositeConsole" target="SYSTEM_OUT">
	  <PatternLayout pattern="COMPOSITE-CTX=${servletContextName} | %msg%n"/>
	</Console>
	<File name="CompositeFile" fileName="${sys:catalina.base}/logs/log4j2-web-test-repro.log" append="true">
	  <PatternLayout pattern="COMPOSITE-CTX=${servletContextName} | %msg%n"/>
	</File>
  </Appenders>
</Configuration>
