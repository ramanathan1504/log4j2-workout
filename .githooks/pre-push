#!/usr/bin/env bash
#
# Refuse a direct push to a protected branch.
#
# GitHub's own branch protection and rulesets both require GitHub Pro on a
# PRIVATE repository, and this repo is private on a Free plan — the API answers
# 403 "Upgrade to GitHub Pro or make this repository public". So the rule lives
# here instead.
#
# Be clear about what this is: a client-side guard against habit and accident,
# not a security control. `--no-verify` skips it, and it only runs on machines
# that have `core.hooksPath` pointed at this directory. Anyone pushing from a
# fresh clone without running the setup below has no guard at all.
#
# Enable (once per clone):
#   git config core.hooksPath .githooks
#
# For enforcement the server actually applies, either upgrade to GitHub Pro and
# add a ruleset requiring pull requests on main and development, or make the
# repository public, where protection is free.

set -euo pipefail

PROTECTED='^refs/heads/(main|development)$'
blocked=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue
  if [[ "$remote_ref" =~ $PROTECTED ]]; then
    branch="${remote_ref#refs/heads/}"
    echo "pre-push: refusing to push directly to '$branch'." >&2
    blocked=1
  fi
done

if [[ $blocked -eq 1 ]]; then
  cat >&2 <<'EOF'

  This repository merges through pull requests only:

      feature branch  ->  PR  ->  development  ->  PR  ->  main

  Push your work to a branch and open a PR instead:

      git switch -c my-change
      git push -u origin my-change
      gh pr create --base development

  If you genuinely need to bypass this (and you rarely do), use:

      git push --no-verify

EOF
  exit 1
fi

exit 0
