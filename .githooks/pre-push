#!/usr/bin/env bash
#
# Refuse a direct push to a protected branch.
#
# The real enforcement is server-side: main carries GitHub branch protection
# requiring a pull request, with enforce_admins on, force pushes and deletions
# disabled, and linear history required. A direct push is refused with GH006
# even under `--no-verify`.
#
# This hook is the fast local echo of that rule. It fails in a second with a
# usable message instead of after a round trip to GitHub, and it keeps the
# workflow discoverable in the repository itself. It is a convenience, not the
# control — `--no-verify` skips it, and it only runs where core.hooksPath points
# here. Nothing depends on it: bypassing it just moves the rejection to the
# server.
#
# Enable (once per clone):
#   git config core.hooksPath .githooks

set -euo pipefail

PROTECTED='^refs/heads/main$'
blocked=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue
  if [[ "$remote_ref" =~ $PROTECTED ]]; then
    branch="${remote_ref#refs/heads/}"
    echo "pre-push: refusing to push directly to '$branch'." >&2
    blocked=1
  fi
done

if [[ $blocked -eq 1 ]]; then
  cat >&2 <<'EOF'

  This repository merges through pull requests only:

      fork or feature branch  ->  PR  ->  main

  Push your work to a branch and open a PR instead:

      git switch -c my-change
      git push -u origin my-change
      gh pr create --base main

  If you genuinely need to bypass this (and you rarely do), use:

      git push --no-verify

EOF
  exit 1
fi

exit 0
