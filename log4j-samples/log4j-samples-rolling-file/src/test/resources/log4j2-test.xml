<Configuration status="warn">
  <Properties>
    <Property name="dir">target/rolling</Property>
  </Properties>

  <Appenders>
    <RollingFile name="Rolling"
                 fileName="${dir}/app.log"
                 filePattern="${dir}/app-%d{yyyy-MM-dd}-%i.log.gz">
      <PatternLayout pattern="%msg%n"/>
      <Policies>
        <!-- Small on purpose: the test drives several rollovers in milliseconds. -->
        <SizeBasedTriggeringPolicy size="1 KB"/>
      </Policies>
      <!--
        max caps the %i counter, NOT the number of files kept. Files beyond it
        are overwritten on the next rollover, which is why Delete exists.
      -->
      <DefaultRolloverStrategy max="10">
        <Delete basePath="${dir}" maxDepth="1">
          <!--
            ORDER MATTERS, and not for the reason it looks like.
            IfAccumulatedFileCount is stateful: it counts every file it is asked
            about. Placed BEFORE IfFileName it also counts the active app.log,
            so the same policy keeps one archive fewer than it says.
            Nesting the counter inside the glob is the only formulation that
            means what it reads like.
          -->
          <IfFileName glob="app-*.log.gz">
            <IfAccumulatedFileCount exceeds="3"/>
          </IfFileName>
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>
  </Appenders>

  <Loggers>
    <Logger name="org.apache.logging.log4j.samples.rollingfile" level="info" additivity="false">
      <AppenderRef ref="Rolling"/>
    </Logger>
    <Root level="warn"/>
  </Loggers>
</Configuration>
