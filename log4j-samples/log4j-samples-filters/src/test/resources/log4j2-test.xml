<Configuration status="warn">
  <!--
    The same filter type at three of its four scopes. Scope decides which events
    a filter ever sees, and it is what people get wrong far more often than the
    filter's own configuration.
  -->

  <!-- CONTEXT scope: every event in the context, before any logger is consulted. -->
  <ThresholdFilter level="trace" onMatch="NEUTRAL" onMismatch="DENY"/>

  <Appenders>
    <File name="AppenderScope" fileName="target/filter-appender.log" append="false">
      <PatternLayout pattern="%level %marker %msg%n"/>
      <!-- APPENDER scope: only events routed to this appender. -->
      <MarkerFilter marker="AUDIT" onMatch="ACCEPT" onMismatch="DENY"/>
    </File>
    <File name="RefScope" fileName="target/filter-ref.log" append="false">
      <PatternLayout pattern="%level %marker %msg%n"/>
    </File>
    <File name="LoggerScope" fileName="target/filter-logger.log" append="false">
      <PatternLayout pattern="%level %marker %msg%n"/>
    </File>
  </Appenders>

  <Loggers>
    <Logger name="org.apache.logging.log4j.samples.filters" level="trace" additivity="false">
      <!-- LOGGER scope: events on this logger, before they reach any appender. -->
      <LevelRangeFilter minLevel="ERROR" maxLevel="INFO" onMatch="NEUTRAL" onMismatch="DENY"/>

      <AppenderRef ref="AppenderScope"/>
      <AppenderRef ref="LoggerScope"/>
      <!-- APPENDER-REF scope: this route only, leaving the appender itself open. -->
      <AppenderRef ref="RefScope">
        <MarkerFilter marker="AUDIT" onMatch="DENY" onMismatch="ACCEPT"/>
      </AppenderRef>
    </Logger>
    <Root level="warn"/>
  </Loggers>
</Configuration>
