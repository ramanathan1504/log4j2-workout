<!--
  status="warn" is deliberate. Log4j reports a plugin it cannot resolve through
  the StatusLogger and then carries on with the element absent, so a
  configuration that silently lost an appender looks identical to one that
  worked. Raise this to "trace" to watch the plugins being registered.
-->
<Configuration status="warn">

  <Appenders>
    <!--
      Both of these are the custom plugins in this module, resolved by the names
      in their @Plugin annotations rather than by class name. If the descriptor
      were missing and package scanning also failed, Log4j would report
      "Unable to locate plugin type for Counting" and continue with no appender.
    -->
    <Counting name="Counting">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n"/>
      <!-- Appender scope: this filter sees only what is routed here. -->
      <EveryNthFilter n="2" onMatch="ACCEPT" onMismatch="DENY"/>
    </Counting>
  </Appenders>

  <Loggers>
    <Root level="info">
      <AppenderRef ref="Counting"/>
    </Root>
  </Loggers>

</Configuration>
