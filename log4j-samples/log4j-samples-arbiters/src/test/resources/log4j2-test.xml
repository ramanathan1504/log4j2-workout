<Configuration status="warn">
  <Appenders>
    <!--
      Arbiters choose at CONFIGURATION time, not per event. The branch not taken
      is not merely inactive - it is never built, so a typo inside it is never
      reported. Nothing here is evaluated again afterwards.
    -->
    <SystemPropertyArbiter propertyName="sample.env" propertyValue="prod">
      <File name="Chosen" fileName="target/arbiter-prod.log" append="false">
        <PatternLayout pattern="PROD %msg%n"/>
      </File>
    </SystemPropertyArbiter>

    <SystemPropertyArbiter propertyName="sample.env" propertyValue="dev">
      <File name="Chosen" fileName="target/arbiter-dev.log" append="false">
        <PatternLayout pattern="DEV %msg%n"/>
      </File>
    </SystemPropertyArbiter>

    <!-- Select/DefaultArbiter: the fallback when no other arbiter matches. -->
    <Select>
      <SystemPropertyArbiter propertyName="sample.tier" propertyValue="gold">
        <File name="Tier" fileName="target/arbiter-tier.log" append="false">
          <PatternLayout pattern="GOLD %msg%n"/>
        </File>
      </SystemPropertyArbiter>
      <DefaultArbiter>
        <File name="Tier" fileName="target/arbiter-tier.log" append="false">
          <PatternLayout pattern="STANDARD %msg%n"/>
        </File>
      </DefaultArbiter>
    </Select>
  </Appenders>

  <Loggers>
    <Logger name="org.apache.logging.log4j.samples.arbiters" level="info" additivity="false">
      <AppenderRef ref="Chosen"/>
      <AppenderRef ref="Tier"/>
    </Logger>
    <Root level="warn"/>
  </Loggers>
</Configuration>
