<Configuration status="warn">
  <Appenders>
    <File name="Ctx" fileName="target/thread-context.log" append="false">
      <!--
        %X{key} prints one MDC entry, %X prints the whole map, %x prints the NDC
        stack. A key that is not set renders as the empty string, not as "null" -
        so a missing value looks identical to a value that is genuinely blank.
      -->
      <PatternLayout pattern="%level [%X{orderId}|%X{tenant}] %x %msg%n"/>
    </File>
  </Appenders>
  <Loggers>
    <Logger name="org.apache.logging.log4j.samples.threadcontext" level="info" additivity="false">
      <AppenderRef ref="Ctx"/>
    </Logger>
    <Root level="warn"/>
  </Loggers>
</Configuration>
