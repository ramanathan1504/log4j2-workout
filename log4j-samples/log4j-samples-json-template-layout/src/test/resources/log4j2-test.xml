<Configuration status="warn">
  <Appenders>
    <!--
      Files rather than an in-memory appender, so the test reads exactly the
      bytes a real deployment would ship. eventTemplateUri points at a classpath
      resource; a path that does not resolve is NOT a build failure - the layout
      falls back to its built-in template and logs one status line, so the output
      stays valid JSON in a shape nobody asked for.
    -->
    <File name="Custom" fileName="target/json-custom.log" append="false">
      <JsonTemplateLayout eventTemplateUri="classpath:BenchLayout.json"/>
    </File>
    <!-- The bundled Elastic Common Schema template, shipped inside the jar. -->
    <File name="Ecs" fileName="target/json-ecs.log" append="false">
      <JsonTemplateLayout eventTemplateUri="classpath:EcsLayout.json"/>
    </File>
  </Appenders>
  <Loggers>
    <Logger name="org.apache.logging.log4j.samples.jsontemplate" level="info" additivity="false">
      <AppenderRef ref="Custom"/>
      <AppenderRef ref="Ecs"/>
    </Logger>
    <Root level="warn"/>
  </Loggers>
</Configuration>
