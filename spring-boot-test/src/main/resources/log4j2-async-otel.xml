<?xml version="1.0" encoding="UTF-8"?>
<!--
  spring-boot-test — sync logging configuration (default).

  Appenders:
    Console       → human-readable PatternLayout  (local dev)
    JsonConsole   → JsonTemplateLayout + Docker containerId + MDC (Docker/K8s/ELK)
    RollingFile   → rolling text log file
    JsonRolling   → rolling JSON log file (for Fluentd/Logstash sidecar)

  To switch to async appenders:
    java -Dlog4j.configurationFile=log4j2-async.xml -jar spring-boot-test-1.0-SNAPSHOT.jar
-->
<Configuration status="WARN" name="SpringBootTest">

    <Properties>
        <Property name="LOG_DIR">logs</Property>
        <Property name="PATTERN">
            %d{yyyy-MM-dd HH:mm:ss.SSS} [%-25t] %-5level %-45logger{1.} [%X{traceId:-}|%X{requestId:-}|%X{user:-}] - %msg%n
        </Property>
    </Properties>

    <Appenders>

        <!-- 1. Console — human-readable, local development -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATTERN}"/>
        </Console>

        <!-- 2. JSON Console — structured output for Docker/K8s stdout capture.
             MDC keys (traceId, requestId, user) appear automatically in the mdc field. -->
        <Console name="JsonConsole" target="SYSTEM_OUT">
            <JsonTemplateLayout>
                <EventTemplateAdditionalField key="containerId" value="${docker:containerId:-unknown}"/>
                <EventTemplateAdditionalField key="app"         value="spring-boot-log4j2-test"/>
                <EventTemplateAdditionalField key="hostname"    value="${env:HOSTNAME:-localhost}"/>
            </JsonTemplateLayout>
        </Console>

        <!-- MongoDB: Sending Spring logs to NoSQL -->
        <NoSql name="MongoAppender">
            <MongoDb4 connection="mongodb://localhost:27017/WorkoutDB.logs" />
        </NoSql>

        <!-- SQL: Sending Spring logs to MySQL (Uses your Factory) -->
        <JDBC name="SqlAppender" tableName="logs">
            <ConnectionFactory class="com.springtest.service.ConnectionFactory" method="getConnection" />
            <Column name="event_date" isEventTimestamp="true" />
            <Column name="level" pattern="%level" />
            <Column name="logger" pattern="%logger" />
            <Column name="message" pattern="%message" />
            <Column name="exception" pattern="%ex{full}" />
        </JDBC>

        <!-- 3. Rolling File — plain text, daily + size rollover -->
        <RollingFile name="RollingFile"
                     fileName="${LOG_DIR}/spring-boot-app.log"
                     filePattern="${LOG_DIR}/spring-boot-app-%d{yyyy-MM-dd}-%i.log.gz"
                     createOnDemand="true">
            <PatternLayout pattern="${PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- 4. Rolling File — JSON, for Fluentd/Logstash sidecar in K8s -->
        <RollingFile name="JsonRollingFile"
                     fileName="${LOG_DIR}/spring-boot-app-json.log"
                     filePattern="${LOG_DIR}/spring-boot-app-json-%d{yyyy-MM-dd}-%i.log.gz"
                     createOnDemand="true">
            <JsonTemplateLayout>
                <EventTemplateAdditionalField key="containerId" value="${docker:containerId:-unknown}"/>
                <EventTemplateAdditionalField key="app"         value="spring-boot-log4j2-test"/>
            </JsonTemplateLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- App packages — TRACE for fine-grained test visibility -->
        <Logger name="com.springtest" level="trace" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="JsonConsole"/>
            <AppenderRef ref="RollingFile"/>
            <AppenderRef ref="JsonRollingFile"/>
        </Logger>

        <!-- Spring Web — DEBUG to see request mappings and HTTP details -->
        <Logger name="org.springframework.web"  level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="JsonConsole"/>
        </Logger>

        <!-- Reduce Spring framework noise (keep INFO) -->
        <Logger name="org.springframework" level="info"/>
        <Logger name="org.apache.tomcat"   level="warn"/>

        <!-- Root — WARN for everything else -->
        <Root level="warn">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="JsonConsole"/>
            <AppenderRef ref="MongoAppender"/> <!-- Add this -->
            <AppenderRef ref="SqlAppender"/>   <!-- Add this -->
        </Root>

    </Loggers>

</Configuration>


