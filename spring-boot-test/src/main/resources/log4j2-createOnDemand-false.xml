<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="OtelTestController">

<Properties>
    <Property name="LOG_DIR">logs</Property>
    <Property name="PATTERN">
        %d{yyyy-MM-dd HH:mm:ss.SSS} [%-25t] %-5level %-45logger{1.} [%X{traceId:-}|%X{requestId:-}|%X{user:-}] - %msg%n
    </Property>
</Properties>

<Appenders>
    <Console name="Console" target="SYSTEM_OUT">
        <PatternLayout pattern="${PATTERN}"/>
    </Console>

    <Console name="JsonConsole" target="SYSTEM_OUT">
        <JsonTemplateLayout>
            <EventTemplateAdditionalField key="containerId" value="${docker:containerId:-unknown}"/>
            <EventTemplateAdditionalField key="app" value="spring-boot-log4j2-test"/>
            <EventTemplateAdditionalField key="hostname" value="${env:HOSTNAME:-localhost}"/>
        </JsonTemplateLayout>
    </Console>

    <RollingFile name="RollingFile"
                 fileName="${LOG_DIR}/spring-boot-app.log"
                 filePattern="${LOG_DIR}/spring-boot-app-%d{yyyy-MM-dd}-%i.log.gz"
                 createOnDemand="false">
        <PatternLayout pattern="${PATTERN}"/>
        <Policies>
            <TimeBasedTriggeringPolicy interval="1"/>
            <SizeBasedTriggeringPolicy size="50MB"/>
        </Policies>
        <DefaultRolloverStrategy max="30"/>
    </RollingFile>

    <RollingFile name="JsonRollingFile"
                 fileName="${LOG_DIR}/spring-boot-app-json.log"
                 filePattern="${LOG_DIR}/spring-boot-app-json-%d{yyyy-MM-dd}-%i.log.gz"
                 createOnDemand="false">
        <JsonTemplateLayout>
            <EventTemplateAdditionalField key="containerId" value="${docker:containerId:-unknown}"/>
            <EventTemplateAdditionalField key="app" value="spring-boot-log4j2-test"/>
        </JsonTemplateLayout>
        <Policies>
            <TimeBasedTriggeringPolicy interval="1"/>
            <SizeBasedTriggeringPolicy size="50MB"/>
        </Policies>
        <DefaultRolloverStrategy max="30"/>
    </RollingFile>

</Appenders>

<Loggers>
    <Logger name="com.springtest" level="trace" additivity="false">
        <AppenderRef ref="Console"/>
        <AppenderRef ref="JsonConsole"/>
        <AppenderRef ref="RollingFile"/>
        <AppenderRef ref="JsonRollingFile"/>
    </Logger>

    <Logger name="org.springframework.web" level="debug" additivity="false">
        <AppenderRef ref="Console"/>
        <AppenderRef ref="JsonConsole"/>
    </Logger>

    <Logger name="org.springframework" level="info"/>
    <Logger name="org.apache.tomcat" level="warn"/>

    <Root level="warn">
        <AppenderRef ref="Console"/>
        <AppenderRef ref="JsonConsole"/>
    </Root>
</Loggers>

</Configuration>

