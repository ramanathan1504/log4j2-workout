@host = http://localhost:8081
@json = application/json

### All scenarios at once
GET {{host}}/api/logs/all

### All log levels + SLF4J bridge
GET {{host}}/api/logs/all-levels

### MDC scenario
GET {{host}}/api/logs/mdc?user=alice&traceId=trace-001

### Exception scenario
GET {{host}}/api/logs/exception

### Marker scenario
GET {{host}}/api/logs/markers

### Async scenario
GET {{host}}/api/logs/async

### App info
GET {{host}}/api/logs/info

### Actuator health
GET {{host}}/actuator/health

### Actuator info
GET {{host}}/actuator/info

### Actuator loggers
GET {{host}}/actuator/loggers

### Set logger level at runtime
POST {{host}}/actuator/loggers/com.springtest
Content-Type: {{json}}

{
  "configuredLevel": "DEBUG"
}

### Reset logger level to INFO
POST {{host}}/actuator/loggers/com.springtest
Content-Type: {{json}}

{
  "configuredLevel": "INFO"
}

